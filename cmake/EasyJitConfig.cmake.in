# Try to find the easy::jit library, headers and optimization pass tool.
#  EasyJit_INCLUDE_DIRS   - the easy::jit include directory
#  EasyJit_LIBRARY_DIRS   - library directory needed to use easy::jit
#  EasyJit_LIBRARY        - runtime library needed to use easy::jit
#  EasyJit_PASS_TOOL      - standalone LLVM optimization pass tool

set(EasyJit_INCLUDE_DIRS "@CMAKE_INSTALL_PREFIX@/include")
set(EasyJit_LIBRARY_DIRS "@CMAKE_INSTALL_PREFIX@/lib")
set(EasyJit_LIBRARY "EasyJitRuntime")
set(EasyJit_PASS_TOOL "@CMAKE_INSTALL_PREFIX@/bin/easy-jit-opt")
